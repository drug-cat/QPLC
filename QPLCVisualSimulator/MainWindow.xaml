<!-- MainWindow.xaml -->
<Window x:Class="QPLCVisualSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QPLCVisualSimulator"
        Title="QPLC Visual Simulator" Height="800" Width="1100"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Run Scan" Click="RunScan_Click" Width="90" Margin="0,0,10,0" ToolTip="Run one scan cycle (F5)"/>
            <Button Content="Tick 100ms" Click="Tick100_Click" Width="90" Margin="0,0,10,0" ToolTip="Advance time 100 ms + scan"/>
            <Button Content="Tick 1s" Click="Tick1000_Click" Width="70" Margin="0,0,10,0" ToolTip="Advance time 1 s + scan"/>
            <Button Content="Reset" Click="Reset_Click" Width="70" Margin="0,0,10,0" ToolTip="Reset all variables and time"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            <Button Content="Ladder/FBD" Click="ToggleView_Click" Width="90" Margin="0,0,10,0" ToolTip="Toggle between Ladder and FBD views (F6)"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            <TextBlock Text="Load Files:" VerticalAlignment="Center" Margin="5,0"/>
            <Button Content="Config" Click="LoadConfig_Click" Width="70" Margin="5,0" ToolTip="Choose a conf.qplc file"/>
            <Button Content="Ladder XML" Click="LoadLadder_Click" Width="80" Margin="5,0" ToolTip="Choose the output XML file"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            <TextBlock Text="Set Variable:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="VariableComboBox" Width="150" Margin="0,0,5,0" ToolTip="Choose a boolean variable"/>
            <ComboBox x:Name="ValueComboBox" Width="100" Margin="0,0,5,0" ToolTip="New value">
                <ComboBoxItem Content="True" Tag="True"/>
                <ComboBoxItem Content="False" Tag="False"/>
            </ComboBox>
            <Button Content="Apply" Click="ApplyValue_Click" Width="70" ToolTip="Apply the value and run a scan"/>
        </StackPanel>

        <!-- Second toolbar: Zoom and Legend -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Slider x:Name="ZoomSlider" Width="200" Minimum="0.5" Maximum="2.0" Value="1.0"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    ValueChanged="ZoomSlider_ValueChanged" ToolTip="Zoom in/out of the ladder view"/>
            <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Width="50" Margin="5,0,20,0"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
            <!-- Color legend -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="5,0" Background="#FFF5F5F5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Legend:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Rectangle Width="20" Height="12" Fill="Green" Stroke="Black" StrokeThickness="1" Margin="0,0,5,0"/>
                        <TextBlock Text="Active / True" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Rectangle Width="20" Height="12" Fill="Gray" Stroke="Black" StrokeThickness="1" Margin="0,0,5,0"/>
                        <TextBlock Text="Inactive / False" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Rectangle Width="20" Height="12" Fill="Yellow" Stroke="Black" StrokeThickness="1" Margin="0,0,5,0"/>
                        <TextBlock Text="Timer" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Rectangle Width="20" Height="12" Fill="LightCyan" Stroke="Black" StrokeThickness="1" Margin="0,0,5,0"/>
                        <TextBlock Text="Counter" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Path Data="M0,12 L6,0 L12,12" Stroke="Green" StrokeThickness="2" Fill="Transparent" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Rising Edge" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <Path Data="M0,0 L6,12 L12,0" Stroke="Green" StrokeThickness="2" Fill="Transparent" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Falling Edge" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Variable display -->
        <GroupBox Grid.Row="2" Header="Variables" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Boolean Variables">
                    <ListBox x:Name="BoolListBox" FontFamily="Consolas" FontSize="12"/>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Numeric Variables">
                    <ListBox x:Name="NumericListBox" FontFamily="Consolas" FontSize="12"/>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Ladder / FBD networks with scroll and zoom -->
        <GroupBox Grid.Row="3" Header="Ladder Networks">
            <ScrollViewer x:Name="LadderScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Viewbox x:Name="LadderViewbox" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <local:LadderView x:Name="LadderViewControl"/>
                </Viewbox>
            </ScrollViewer>
        </GroupBox>

        <!-- Status bar -->
        <StatusBar Grid.Row="4" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="StatusTime" Text="Time: 0 ms" FontFamily="Consolas"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusScans" Text="Scans: 0" FontFamily="Consolas"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusNetwork" Text="Network: -" FontFamily="Consolas"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusLastOp" Text="Ready" FontFamily="Consolas" Foreground="DarkGreen"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>