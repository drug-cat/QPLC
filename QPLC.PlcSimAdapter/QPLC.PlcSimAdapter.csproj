<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>QPLC.PlcSimAdapter</RootNamespace>
    <AssemblyName>QPLC.PlcSimAdapter</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- PLCSIM Advanced Runtime API is located on the host machine; not a NuGet package -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QPLC.Core\QPLC.Core.csproj" />
  </ItemGroup>

  <!-- Copy the native PLCSIM bridge DLL next to the managed binary if it was
       built by CMake (skipped when PLCSIM Advanced is not installed). -->
  <Target Name="CopyPlcSimBridge" AfterTargets="Build">
    <ItemGroup>
      <_BridgeDll Include="..\build\libqplc_plcsim_bridge.dll" Condition="Exists('..\build\libqplc_plcsim_bridge.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
